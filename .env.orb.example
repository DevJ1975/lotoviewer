# OrbStack / docker compose preview: cp .env.orb.example .env.orb, fill in,
# then: docker compose --env-file .env.orb -f docker-compose.orb.yml up --build
# .env.orb is gitignored. Point this at a Supabase branch or staging project,
# not production, while previewing unreleased migrations.

# ── Required: Supabase (shared by web + studio) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Demo script only (scripts/strike-demo-wls.sh); the containers never read these.
# Supabase → Connect → Session pooler: the host, plus the database password.
SUPABASE_DB_HOST=
SUPABASE_DB_PASSWORD=
# Comma-separated. Superadmin also needs profiles.is_superadmin = true.
SUPERADMIN_EMAILS=

# ── Required: studio ─────────────────────────────────────────────────────────
# Any long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# ── AI (web: assistant, LOTO Coach, RAG) ─────────────────────────────────────
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ── Narration (studio: python manage.py narrate ...) ─────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Optional ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://web.soteria.orb.local
# Tenants whose owners/admins may review their own tenant modules in the studio.
STUDIO_TENANT_IDS=
CRON_SECRET=
# "Train now" permit kiosk links; at least 32 random characters.
STRIKE_KIOSK_SECRET=
# Soteria STRIKE tablet app offline quiz keys; at least 32 random characters.
STRIKE_OFFLINE_SECRET=
RESEND_API_KEY=
INVITE_FROM_EMAIL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
