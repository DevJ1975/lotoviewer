{
  "name": "lotoviewer-monorepo",
  "version": "1.13.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "start": "npm --workspace web run start",
    "lint": "npm --workspace web run lint",
    "test": "npm --workspace web run test",
    "test:core": "vitest run --root packages/core",
    "check:migrations": "node scripts/check-migration-numbers.mjs",
    "migration:next": "node scripts/next-migration-number.mjs",
    "check:manuals": "node scripts/check-manual-coverage.mjs",
    "check:deeplinks": "node scripts/check-deeplink-placeholders.mjs",
    "check:nav": "node scripts/check-nav-sync.mjs",
    "check:version": "node scripts/check-version-sync.mjs",
    "check:repo": "npm run check:migrations && npm run check:manuals && npm run check:nav && npm run check:version && ALLOW_DEEPLINK_PLACEHOLDERS=1 npm run check:deeplinks",
    "check:wiki": "node scripts/check-wiki-sync.mjs",
    "build:tokens": "node scripts/build-spectrum-tokens.mjs",
    "check:wiki:staged": "node scripts/check-wiki-sync.mjs --staged",
    "doctor:git": "bash scripts/repo-doctor.sh",
    "wiki:touch": "node scripts/wiki-touch.mjs"
  },
  "dependencies": {
    "expo-router": "~6.0.23"
  },
  "overrides": {
    "shell-quote": "1.9.0",
    "fast-uri": "3.1.3",
    "hono": "4.12.27",
    "vite": "8.0.16",
    "undici": "6.27.0",
    "ws": "8.21.0",
    "react-native": {
      "ws": "6.2.4"
    },
    "@react-native/dev-middleware": {
      "ws": "6.2.4"
    },
    "metro": {
      "ws": "7.5.11"
    },
    "react-devtools-core": {
      "ws": "7.5.11"
    }
  }
}
