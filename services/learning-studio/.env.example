# Standalone run of the studio (docker compose -f ../../docker-compose.orb.yml uses
# the repo-root .env.orb instead). Copy to .env and fill in.

# Required
DJANGO_SECRET_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated; must also have profiles.is_superadmin = true to manage global modules.
SUPERADMIN_EMAILS=
ALLOWED_HOSTS=studio.soteria.orb.local,localhost
CSRF_TRUSTED_ORIGINS=https://studio.soteria.orb.local

# Optional
# Tenants whose owners/admins may review their own tenant modules.
STUDIO_TENANT_IDS=
# Narration (python manage.py narrate ...)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Local preview over plain HTTP:
DJANGO_DEBUG=0
DJANGO_SSL_REDIRECT=0
