# SDS Parser service configuration. Copy to .env (or set in your host).

# Shared secret. When set, every request must send a matching `X-API-Key`
# header. Strongly recommended in any shared/deployed environment — the
# /parse/stage endpoint can write to your database. Leave unset only for
# local development.
SDS_PARSER_API_KEY=

# Supabase — required ONLY for the /parse/stage endpoint (download an SDS and
# write the parse into the review queue). The service-role key bypasses RLS,
# so it must never be exposed to a browser; this server keeps it server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Background parse jobs (POST /jobs/parse-sds + an in-process worker). OCR of a
# long scanned SDS can take minutes, longer than the web app's routes can wait,
# so the web app queues those parses here. Requires migration 294
# (sds_parse_jobs) and the Supabase vars above. Leave unset to disable: the
# endpoint then answers 503 and the web app parses synchronously instead.
SDS_PARSE_JOBS_ENABLED=

# Generic background jobs (POST /jobs + an in-process worker): document reading,
# regulation loading, history imports. Requires migration 295 (service_jobs) and
# the Supabase vars above. Leave unset to disable: POST /jobs then answers 503
# and the web app falls back to its synchronous behaviour.
SERVICE_JOBS_ENABLED=
