# Copy to .env for local development. Never commit real values.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supavisor SESSION mode (port 5432), connecting as platform_svc
# (migration 294). Transaction mode (6543) is not supported.
DATABASE_URL=postgres://platform_svc.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth verification: set SUPABASE_URL (JWKS / asymmetric keys) or
# SUPABASE_JWT_SECRET (legacy HS256), not both.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=

SENTRY_DSN=
