# Copy to .env for local runs (docker compose reads it). Never commit a real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
ALLOWED_HOSTS=photos.soteriafield.app,localhost
CSRF_TRUSTED_ORIGINS=https://photos.soteriafield.app
# Local http only: set to 0 so the dev server does not redirect to https.
DJANGO_SSL_REDIRECT=1

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Snak King tenant uuid (loto_equipment.tenant_id)
WALKDOWN_TENANT_ID=ae3f1973-4c3e-4b6e-b91f-9de5ff10529e
# Platform superadmins who may sign in even without a tenant membership
SUPERADMIN_EMAILS=
# Where placards live; report links point at <this>/qr/<token>
PLATFORM_URL=https://soteriafield.app

# Optional: lets the app email maintenance supervisors itself, over any SMTP
# provider. Without EMAIL_HOST and WALKDOWN_FROM_EMAIL the request screen offers a
# pre-filled mailto: link instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 587 uses STARTTLS (the default). For port 465 set EMAIL_USE_SSL=1.
EMAIL_USE_TLS=1
EMAIL_USE_SSL=
# A sender your provider has verified, e.g. Trainovations <noreply@trainovations.com>
WALKDOWN_FROM_EMAIL=
