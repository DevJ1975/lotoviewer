# Source control
.git
.github

# Build artefacts — excluded so Docker only sees clean source
.next
out
apps/web/.next
apps/mobile/.next

# All node_modules — Docker's own install stage creates them
node_modules
apps/*/node_modules
packages/*/node_modules
services/*/node_modules

# Test output
coverage
**/coverage

# Local env files — secrets are injected at runtime via ECS Secrets Manager,
# never baked into the image
.env*
!.env.example

# Editor / OS noise
.DS_Store
*.pem
*.log

# CDK output — not needed in the image
infra/cdk/cdk.out
infra/cdk/node_modules

# Python virtualenvs and caches (OSHA ingest scripts)
.venv*/
**/__pycache__
scripts/.osha-build
